# Poem generation — server-side only. Never commit real values.
# The browser never sees these; they are read by the Worker and by the Astro
# dev server (local). See README.md.
#
# Production uses the Cloudflare Workers AI binding (`ai.binding: "AI"` in
# wrangler.jsonc), which needs no key and is free on the Workers Free plan.
# The variables below are the fallback OpenAI-compatible HTTP path, and are what
# `astro dev` uses (it has no binding). Leave them unset to run without poems.

# An OpenAI-compatible chat-completions endpoint that accepts an image.
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# The API key for that endpoint. Use `wrangler secret put AI_API_KEY` in production.
AI_API_KEY=replace-me
# Optional model id. The HTTP path defaults to gpt-4o-mini; the Workers AI
# binding defaults to @cf/meta/llama-4-scout-17b-16e-instruct.
AI_MODEL=gpt-4o-mini
